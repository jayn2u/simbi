<Window x:Class="Simbi.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Simbi · Windows" Width="1240" Height="820" MinWidth="940" MinHeight="620" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="68"/><RowDefinition Height="38"/></Grid.RowDefinitions>
    <Border BorderBrush="#DFE6E0" BorderThickness="0,0,0,1" Background="White">
      <DockPanel Margin="22,12">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#176B5A" CornerRadius="9" Width="38" Height="38"><TextBlock Text="S" FontSize="26" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/></Border><StackPanel Margin="12,0,24,0"><TextBlock Text="simbi" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="WINDOWS NATIVE" FontSize="9" Foreground="#6B7C72"/></StackPanel></StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="RetryButton" Content="Retry transcript" Click="Retry_Click" ToolTip="Send saved speech segments directly to ChatGPT"><Button.ContextMenu><ContextMenu><MenuItem Header="Discard pending speech…" Click="Discard_Click"/></ContextMenu></Button.ContextMenu></Button><Button x:Name="SummaryButton" Content="Generate AI notes" Click="Summary_Click"/><Button Content="Settings" Click="Settings_Click" Margin="0"/></StackPanel>
        <TextBlock x:Name="CurrentTitle" Text="Your conversations, remembered." FontWeight="SemiBold" FontSize="17" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#F0F4EE" BorderBrush="#DFE6E0" BorderThickness="0,0,1,0">
        <DockPanel Margin="16,20,16,12">
          <StackPanel DockPanel.Dock="Top"><TextBlock Text="YOUR LIBRARY" Foreground="#66776B" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,14"/><Button x:Name="NewNoteButton" Content="＋  New note" Click="NewNote_Click" Margin="0,0,0,12" Background="#176B5A" Foreground="White" AutomationProperties.Name="New note"/><TextBox x:Name="SearchBox" AutomationProperties.Name="Search notes" ToolTip="Search notes" TextChanged="Search_Changed" Margin="0,0,0,12"/></StackPanel>
          <StackPanel DockPanel.Dock="Bottom"><Button Content="Choose notes folder…" Click="Folder_Click" Margin="0,12,0,4"/><TextBlock x:Name="RootLabel" FontSize="10" Foreground="#6B7C72" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
          <ListBox x:Name="NotesList" Background="Transparent" BorderThickness="0" SelectionChanged="Notes_Changed" AutomationProperties.Name="Notes library" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>
      <Grid Grid.Column="2" Margin="24,18,24,12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12"><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Button x:Name="RecordButton" Content="●  Record" Click="Record_Click" Background="#176B5A" Foreground="White" AutomationProperties.Name="Record"/><CheckBox x:Name="MicCheck" Content="Microphone" VerticalAlignment="Center" Margin="10,0,14,0"/><CheckBox x:Name="SystemCheck" Content="System audio" VerticalAlignment="Center"/><ProgressBar x:Name="Level" Width="72" Height="5" Maximum="1" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#176B5A"/></StackPanel><TextBlock x:Name="RecordingTime" Text="00:00:00" FontFamily="Consolas" Foreground="#68766D" VerticalAlignment="Center" HorizontalAlignment="Right"/></DockPanel>
        <Border Grid.Row="1" Background="#EFF4EE" CornerRadius="6" Padding="12,9" Margin="0,0,0,16"><TextBlock x:Name="AccountBanner" TextWrapping="Wrap" FontSize="12" Foreground="#53685A"/></Border>
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Background="White" BorderBrush="#DFE6E0" BorderThickness="1" CornerRadius="7"><DockPanel><Border DockPanel.Dock="Top" Padding="16,12" BorderBrush="#E7ECE6" BorderThickness="0,0,0,1"><DockPanel><TextBlock Text="Notes" FontWeight="SemiBold"/><TextBlock x:Name="SaveLabel" Text="Saved locally" HorizontalAlignment="Right" Foreground="#718074" FontSize="11"/></DockPanel></Border><TextBox x:Name="NoteEditor" TextChanged="Editor_Changed" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="18" VerticalContentAlignment="Top" FontSize="15" AutomationProperties.Name="Note editor"/></DockPanel></Border>
          <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="Transparent"/>
          <TabControl Grid.Column="2" Background="White" BorderBrush="#DFE6E0">
            <TabItem Header="Transcript"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Sources are labelled; individual speaker recognition is not available." TextWrapping="Wrap" Foreground="#718074" FontSize="11" Margin="12"/><ListBox x:Name="TranscriptList" Grid.Row="1" BorderThickness="0" MouseDoubleClick="Transcript_DoubleClick" AutomationProperties.Name="Transcript"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextWrapping="Wrap" Margin="0,3,0,8"/></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></TabItem>
            <TabItem x:Name="SummaryTab" Header="AI notes"><TextBox x:Name="SummaryEditor" TextChanged="SummaryEditor_Changed" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="16" VerticalContentAlignment="Top" AutomationProperties.Name="AI notes editor"/></TabItem>
            <TabItem x:Name="ChatTab" Header="Ask"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBox x:Name="ChatOutput" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Text="Ask a question about this note. Codex reads the note and transcript using your ChatGPT account." VerticalContentAlignment="Top" AutomationProperties.Name="Chat response"/><DockPanel Grid.Row="1" Margin="0,12,0,0"><Button x:Name="AskButton" DockPanel.Dock="Right" Content="Ask" Click="Ask_Click" Margin="8,0,0,0"/><TextBox x:Name="QuestionBox" AutomationProperties.Name="Question" ToolTip="Ask about this note" KeyDown="Question_KeyDown"/></DockPanel></Grid></TabItem>
          </TabControl>
        </Grid>
        <DockPanel Grid.Row="3" Margin="0,14,0,0"><Button DockPanel.Dock="Right" Content="Add files…" Click="AddFiles_Click" Margin="8,0,0,0"/><Button x:Name="ConvertButton" DockPanel.Dock="Right" Content="Convert selected" Click="Convert_Click" Margin="8,0,0,0"/><ListBox x:Name="Attachments" Height="52" Background="Transparent" BorderThickness="0" MouseDoubleClick="Attachment_DoubleClick" AutomationProperties.Name="Attachments"><ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox></DockPanel>
      </Grid>
    </Grid>
    <Border Grid.Row="2" BorderBrush="#DFE6E0" BorderThickness="0,1,0,1" Background="White"><DockPanel Margin="22,12"><Button x:Name="PlayButton" Content="▶  Play" Click="Play_Click" AutomationProperties.Name="Play recording"/><TextBlock x:Name="PlaybackTime" DockPanel.Dock="Right" Text="00:00:00 / 00:00:00" Width="175" VerticalAlignment="Center" TextAlignment="Right" Foreground="#627469" FontFamily="Consolas"/><Slider x:Name="SeekSlider" Minimum="0" Maximum="1" VerticalAlignment="Center" PreviewMouseLeftButtonUp="Seek_Changed" KeyUp="Seek_KeyUp" AutomationProperties.Name="Playback position" Margin="12,0"/></DockPanel></Border>
    <DockPanel Grid.Row="3" Margin="22,0"><TextBlock x:Name="QueueLabel" DockPanel.Dock="Right" Text="Plain files · Local storage" FontSize="11" VerticalAlignment="Center" Foreground="#718074"/><TextBlock x:Name="StatusLabel" Text="Ready" VerticalAlignment="Center" FontSize="11" Foreground="#53685A" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></DockPanel>
  </Grid>
</Window>
